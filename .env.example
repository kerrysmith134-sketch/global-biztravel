# 本地开发配置示例。真实 .env 不入库（见 .gitignore）。
# 这里全部是本地开发用的弱口令 —— 不含任何生产密钥。红线 RL-05：
# 生产环境的一切凭证必须来自密钥管理/环境变量，禁止写入代码或配置文件。

GBT_ENV=local

# 应用连接（受 RLS 约束）：见设计文档 v2.0 第 11.2 章
GBT_DATABASE_URL=postgresql+psycopg://gbt_app:gbt_app_pw@localhost:55432/gbt_os
# 迁移连接（表 owner）
GBT_MIGRATION_DATABASE_URL=postgresql+psycopg://gbt_owner:gbt_owner_pw@localhost:55432/gbt_os

# 本地开发用固定身份（生产走真实认证）
GBT_DEV_AUTH=true
GBT_DEV_ORG_ID=11111111-1111-1111-1111-111111111111
GBT_DEV_USER_ID=22222222-2222-2222-2222-222222222222

# 规划引擎
GBT_PLANNING_SOLVER=ortools
GBT_SOLVER_BUDGET_SECONDS=10
GBT_CANDIDATE_LIMIT=8

# 主动式运行时（设计文档 v2.0 第 8.4 章）
GBT_SUGGESTION_COOLDOWN_HOURS=24
GBT_DAILY_SUGGESTION_CAP=3
GBT_SUGGESTION_CONFIDENCE_THRESHOLD=0.6
GBT_PROACTIVE_SCAN_INTERVAL_SECONDS=60
GBT_PROACTIVE_VISA_LOOKAHEAD_HOURS=72
GBT_PROACTIVE_DISMISSAL_PENALTY=0.05
GBT_PROACTIVE_MAX_FEEDBACK_PENALTY=0.3
GBT_PROACTIVE_FEEDBACK_WINDOW_DAYS=90

# 记忆层（第 9 章）
GBT_MEMORY_EMBEDDING_DIM=256
GBT_MEMORY_TIME_DECAY_HALF_LIFE_DAYS=90
GBT_MEMORY_EMBEDDING_PROVIDER=hash
# GBT_MEMORY_EMBEDDING_BASE_URL=
# GBT_MEMORY_EMBEDDING_API_KEY=
GBT_RETENTION_DAYS=365
GBT_RETENTION_INTERVAL_SECONDS=86400
# GBT_FIELD_ENCRYPTION_KEY=
GBT_MEMORY_REVIEW_INTERVAL_SECONDS=300
GBT_METRICS_SNAPSHOT_INTERVAL_SECONDS=3600
GBT_PUSH_PROVIDER=inapp
GBT_PUSH_MAX_ATTEMPTS=3

# SMTP（GBT_PUSH_PROVIDER=smtp）
# GBT_SMTP_HOST=smtp.example.com
# GBT_SMTP_PORT=587
# GBT_SMTP_USERNAME=
# GBT_SMTP_PASSWORD=
# GBT_SMTP_FROM=no-reply@example.com
# GBT_SMTP_USE_TLS=true

# APNs（GBT_PUSH_PROVIDER=apns）
# GBT_APNS_KEY_ID=
# GBT_APNS_TEAM_ID=
# GBT_APNS_PRIVATE_KEY=/path/to/AuthKey_XXX.p8
# GBT_APNS_TOPIC=com.example.app
# GBT_APNS_USE_SANDBOX=true

# LLM 网关（第 7 章）：local 默认 stub provider，不外呼、不缺网也能跑
GBT_LLM_PROVIDER=stub
GBT_LLM_TEMPERATURE=0
GBT_LLM_SEED=0
GBT_LLM_MAX_TOKENS=1024
GBT_LLM_COST_PER_1K_TOKENS=0
# GBT_LLM_API_KEY=  # 红线 RL-05：不落库、不写入任何文件，只从环境变量注入

# Worker
GBT_WORKER_POLL_SECONDS=2
GBT_JOB_LEASE_SECONDS=60
GBT_OUTBOX_BATCH_SIZE=50
GBT_RETRY_BASE_SECONDS=2
GBT_RETRY_MAX_SECONDS=300
GBT_MAX_ATTEMPTS=5